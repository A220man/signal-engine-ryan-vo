# Signal Engine Environment Configuration
# Copy to .env and fill in values

# App
APP_NAME=signal-engine
APP_VERSION=1.0.0
ENVIRONMENT=development
DEBUG=true

# Server
HOST=127.0.0.1
PORT=8000

# Database
DATABASE_URL=sqlite+aiosqlite:///./signal_engine.db

# Auth - Keycloak OIDC
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=signal-engine
KEYCLOAK_CLIENT_ID=signal-engine-client
KEYCLOAK_CLIENT_SECRET=
OIDC_ISSUER_URL=http://localhost:8080/realms/signal-engine
OIDC_AUDIENCE=signal-engine-api

# Demo mode (local only - MUST be false in production)
DEMO_MODE=true
DEMO_USER_EMAIL=demo@local
DEMO_USER_ROLE=operator

# LLM (optional)
LLM_API_KEY=
LLM_PROVIDER=openai-compatible
LLM_MODEL=gpt-4o-mini
LLM_BASE_URL=

# File upload
MAX_UPLOAD_SIZE=52428800
UPLOAD_DIR=./uploads

# CORS
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]